{
  "name": "prosapia-tools",
  "private": true,
  "description": "Repository tooling. The browser code has its own package in web/.",
  "scripts": {
    "format": "prettier --write \"**/*.md\" \"web/src/**/*.ts\"",
    "check": "prettier --check \"**/*.md\" \"web/src/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "license": "BSD-3-Clause"
}
